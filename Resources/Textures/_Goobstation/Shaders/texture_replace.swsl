// Procedural stone shader: replaces sprite color with a grey stone appearance
// while preserving the original sprite alpha (shape/silhouette).
light_mode unshaded;

// Controls the grain size. Higher = coarser stone pattern.
uniform highp float tileScale;

// Simple hash for discrete black dot noise
highp float hash(highp vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
    highp vec4 original = zTexture(UV);
    if (original.a <= 0.0) {
        discard;
    }

    highp vec2 pos = UV * tileScale;

    // Smooth macro variation: large grey patches
    highp float macro = zFBM(pos);

    // Finer grain: medium stone texture
    highp float grain = zFBM(pos * 2.5 + vec2(4.3, 1.7));

    // Grey stone base: 0.38 to 0.60
    highp float grey = 0.38 + macro * 0.16 + grain * 0.06;

    // Discrete black dots via hash grid
    highp vec2 cell = floor(pos * 3.0);
    highp float isDot = step(0.84, hash(cell)); // ~16% of cells become dark dots
    grey -= isDot * 0.22;

    // Dark veins/cracks from FBM
    highp float vein = smoothstep(0.50, 0.56, zFBM(pos * 1.8 + vec2(8.1, 3.3)));
    grey -= vein * 0.12;

    grey = clamp(grey, 0.07, 0.78);

    COLOR = vec4(vec3(grey), original.a);
}
